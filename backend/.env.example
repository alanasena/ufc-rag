# Copie este arquivo para .env e coloque sua chave (grátis em https://aistudio.google.com/apikey)
GEMINI_API_KEY=cole_sua_chave_aqui

# Modelos do Gemini (opcional, já tem valores padrão)
MODELO_LLM=gemini-3.1-flash-lite
MODELO_RESERVA=gemini-3.8-flash

# Sites que podem chamar a API (separados por vírgula)
CORS_ORIGINS=http://localhost:3000
